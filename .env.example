# Copy this file to .env.local and adjust values as needed.
# .env and .env.local are gitignored and safe to customize locally.

# Controls whether the DebugPanel (Force Win/Loss, Autoplay, Solver controls)
# is included in the build. Set to "false" in CI to strip it from production.
# Defaults to "true" for local development.
VITE_SHOW_DEBUG=true
