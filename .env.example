# Copy this file to .env.local and adjust values as needed.
# .env and .env.local are gitignored and safe to customize locally.

# Controls the default visibility of the DebugPanel (Force Win/Loss, Autoplay, Solver controls).
# "true" = visible by default (local dev), "false" = hidden by default (CI/prod still toggleable).
# Override at runtime in the browser console via tombDebug.enable()/disable()/toggle()
# (persisted in localStorage key tomb:showDebug).
VITE_SHOW_DEBUG=true
